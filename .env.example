# Copy to .env and fill in. Never commit .env.

# StateBook Atlas API bearer token.
# "demo" is the public evaluation token documented at
# https://statebook.zendesk.com/hc/en-us/articles/360016198753-Authentication-and-Licensing
# It only grants access to the Burlington-South Burlington, VT metro area.
STATEBOOK_API_TOKEN=demo

# Atlas base URL. Rarely needs changing.
STATEBOOK_API_BASE_URL=https://api.statebook.com

# Per-request timeout in seconds.
STATEBOOK_TIMEOUT_SECONDS=30

# Number of retries after the first attempt (bounded).
STATEBOOK_MAX_RETRIES=2

# Optional, and can instead be pasted into the top of the app sidebar at runtime.
# Enables the conversational assistant and lets a model rewrite the recommendation.
# When absent, both fall back to deterministic text built from the same evidence, so
# no LLM is required to run the demo.
OPENAI_API_KEY=
# The model only rewrites grounded text and its output is verified against the evidence,
# so the cost tier is the sensible default. Overridable in the sidebar.
RLI_LLM_MODEL=gpt-5.6-luna

# Log level: DEBUG, INFO, WARNING, ERROR
RLI_LOG_LEVEL=INFO

# Where the Next.js client looks for the API. Set this only if you move the API off the
# default port; scripts/dev.sh passes it through automatically. It is a NEXT_PUBLIC_ value
# and is therefore visible in the browser bundle, so it must never hold a credential.
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# Browser origins allowed to call the API, comma-separated. Replaces the default of
# localhost:3000, and scripts/dev.sh sets it from WEB_PORT. Wildcards are not supported:
# the API accepts an OpenAI key in a header, so any origin being able to send one would be
# a credential-forwarding hole. Getting this wrong surfaces in the UI as "cannot reach the
# analysis service", because a failed preflight is indistinguishable from a dead server.
# RLI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
